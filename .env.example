# ==========================================
# Telegram Digital Store Bot Environment Config
# ==========================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Administrator Telegram User IDs (comma-separated for multiple admins)
ADMIN_IDS=5720673756

# Paytm Business Merchant Credentials
PAYTM_MID=your_paytm_mid_here
PAYTM_MERCHANT_NAME=Premium Digital Store
PAYTM_UPI_ID=your_merchant_upi_id@pty

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/storebot?retryWrites=true&w=majority&appName=Cluster0

# Support & Channel Information
SUPPORT_USERNAME=@YourSupportHandle
CHANNEL_USERNAME=@YourChannelHandle

# Store Settings Defaults
MIN_DEPOSIT=10.0
REFERRAL_PERCENT=5.0
AUTO_VERIFY_INTERVAL=15
